<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <LangVersion>latest</LangVersion>
    <!-- No NuGet audit suppressions. Vulnerable transitive packages are resolved by
         pinning a non-affected version in Directory.Packages.props, never by NoWarn:
         a suppression silences every future advisory of the same class. -->
  </PropertyGroup>
</Project>
