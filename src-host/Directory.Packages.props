<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Microsoft.ApplicationInsights" Version="2.22.0" />
    <PackageVersion Include="FluxIndex.Core" Version="0.13.19" />
    <PackageVersion Include="FluxIndex.SDK" Version="0.13.19" />
    <PackageVersion Include="FluxIndex.Storage.SQLite" Version="0.13.19" />
    <PackageVersion Include="FluxIndex.Extensions.FileVault" Version="0.13.19" />
    <PackageVersion Include="FileFlux" Version="0.10.11" />
    <PackageVersion Include="FluxCurator" Version="0.7.6" />
    <PackageVersion Include="LMSupply.Embedder" Version="0.35.1" />
    <PackageVersion Include="LMSupply.Generator" Version="0.35.1" />
    <PackageVersion Include="IronProw.LMSupply" Version="0.1.0" />
    <PackageVersion Include="IronProw.IronHive" Version="0.2.2" />
    <PackageVersion Include="sqlite-vec" Version="0.1.7-alpha.2.1" />
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.9" />
  </ItemGroup>
  <!-- Transitive security pins.
       These packages are not referenced by our code; they are pulled in through the
       dependency graph at a version that a published advisory flags. Because NuGet
       audit failures are build errors here (TreatWarningsAsErrors), each one is lifted
       to a non-affected version with a direct PackageReference in the consuming project.
       Every pin states the condition under which it should be removed — a pin without an
       expiry is indistinguishable from a permanent suppression. -->
  <ItemGroup Label="Transitive security pins">
    <!-- Pulled in by the retrieval SDK -> HTML pipeline -> AngleSharp 1.4.0.
         GHSA-pgww-w46g-26qg (moderate, mXSS via MathML annotation-xml): affected < 1.5.0.
         Remove once the retrieval SDK line in use no longer resolves AngleSharp below 1.5.0. -->
    <PackageVersion Include="AngleSharp" Version="1.5.2" />
    <!-- Pulled in by Microsoft.Data.Sqlite -> SQLitePCLRaw.bundle_e_sqlite3 -> lib.e_sqlite3 2.1.11.
         GHSA-2m69-gcr7-jv3q (high, vulnerable bundled SQLite): affected <= 2.1.11, so 2.1.12
         is outside the audited range rather than an upstream-declared fix.
         Remove once the SQLite provider resolves 2.1.12 or later on its own. -->
    <PackageVersion Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.12" />
  </ItemGroup>
  <ItemGroup>
    <PackageVersion Include="xunit" Version="2.9.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.8" />
    <PackageVersion Include="FluentAssertions" Version="8.10.0" />
  </ItemGroup>
</Project>
